.DS_Store

# Node / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js
.next/
out/

# Production build output (if used)
dist/
build/

# Local env files
.env
.env.*

# Working checkpoint + transient logs from the indexing script (not part of
# the runtime index — and not something we want bundled into the agent-runner
# tarball that ships into Vercel Sandbox).
agent-runner/data/rag/**/.contextualized.json
agent-runner/data/rag/*-build.log

# NOTE: agent-runner/data/rag/<framework>/{chunks,vectors,meta}.json is
# intentionally NOT ignored — those files are the prebuilt RAG index and must
# be committed so they ship inside the agent-runner tarball that loads into
# Vercel Sandbox at runtime. Rebuild via:
#   node scripts/build-index.mjs --framework <id> --force

# Source PDFs for the RAG indices live outside source control to keep the
# repo small and avoid licensing issues. The CBAM PDF lives in a sibling
# folder.

# Logs
logs/
*.log

# TypeScript
*.tsbuildinfo

# Editor / OS
.vscode/
Thumbs.db

# Local artifacts from scripts/build-runner-tarball.mjs. The tarball is
# uploaded to Vercel Blob via CI (or manually with `npm run publish:runner`)
# and never lives in source control.
agent-runner-*.tar.gz

