.DS_Store

# Node / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js
.next/
out/

# Production build output (if used)
dist/
build/

# Local env files
.env
.env.*

# Working checkpoint from the indexing script (not part of the runtime index)
data/rag/.contextualized.json

# NOTE: data/rag/{chunks,vectors,meta}.json is intentionally NOT ignored —
# those files are the prebuilt RAG index and must be committed so they ship
# with the Vercel deployment. Rebuild via `node scripts/build-index.mjs --force`.

# Logs
logs/
*.log

# TypeScript
*.tsbuildinfo

# Editor / OS
.vscode/
Thumbs.db

