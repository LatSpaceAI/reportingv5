# Supabase — copy this file to `.env.local` and fill in real values.
# Settings → API in your Supabase project dashboard.

# Project URL (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# anon public key (safe for the browser; only used if you add client-side queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# service_role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_, never import
# into a Client Component. Bypasses RLS; full read/write on the esg schema.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# OpenAI — SERVER ONLY. Powers the AI Dashboard (/dashboard) and ALL three
# sandbox agent modes (chat, write, fill) via the OpenAI Agents SDK. Required;
# passed into the sandbox env by the dispatcher. Also used by the offline RAG
# index builder (scripts/build-index.mjs) for contextual retrieval.
OPENAI_API_KEY=YOUR-OPENAI-KEY

# Optional model overrides for the agent modes (defaults shown).
# OPENAI_CHAT_MODEL=gpt-5.5
# OPENAI_WRITE_MODEL=gpt-5.5
# OPENAI_FILL_MODEL=gpt-5.5
# OPENAI_CONTEXTUALIZER_MODEL=gpt-5.4-mini   # used by scripts/build-index.mjs

# Voyage — SERVER ONLY. RAG embeddings (framework indices + uploaded PDFs).
# Passed into the sandbox env by the dispatcher.
VOYAGE_API_KEY=YOUR-VOYAGE-KEY

# ---------------------------------------------------------------------------
# Demo sign-in — SERVER ONLY (never prefix with NEXT_PUBLIC_).
#
# The login page asks for an email and a password. Sign-in succeeds when the
# address matches one of the demo accounts hard-coded in src/lib/auth.ts and
# the password matches DEMO_PASSWORD below. The accounts are:
#
#   esg@demo.com       Rahul Ravi — Central ESG     (Birla Estates)
#   site@latspace.in   Site Lead  — Site Reporting  (Birla Estates)
#
# All accounts share this one password. If unset, src/lib/auth.ts falls back to
# "birla-estates" so a fresh clone runs without any env setup.
DEMO_PASSWORD=birla-estates
#
# Auto sign-in. OFF by default: every page sits behind the login page, and the
# session ends when the browser closes.
#
# Set this to "on" for an unattended demo deployment, where a visitor arriving
# without a session is signed in automatically as esg@demo.com and lands on the
# page they asked for, so a shared link opens the app instead of a login form.
# Signing out still keeps you out until you sign back in. Be aware that with it
# on, closing the browser and returning silently starts a new session — which
# looks like the app never logs you out.
# DEMO_AUTO_SIGN_IN=on
#
# This is demo-grade auth: the password is compared in plaintext and the session
# cookie is unsigned, holding only the account id — so anyone who can set a
# cookie can walk in. Replace verifyCredentials() in src/lib/auth.ts with a real
# identity provider before this is exposed to anyone outside a demo.
# ---------------------------------------------------------------------------
