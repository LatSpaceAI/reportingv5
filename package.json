{
  "name": "reporting-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "agent-runner"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:runner": "node scripts/build-runner-tarball.mjs",
    "publish:runner": "node scripts/build-runner-tarball.mjs --upload",
    "smoke:chat": "node scripts/smoke-runner.mjs chat",
    "smoke:write": "node scripts/smoke-runner.mjs write",
    "smoke:fill": "node scripts/smoke-runner.mjs fill",
    "esg:resolve": "node scripts/resolve-birla.mjs",
    "esg:resolve:dry": "node scripts/resolve-birla.mjs --dry-run",
    "esg:resolve-scope3": "node scripts/resolve-scope3.mjs",
    "esg:resolve-scope3:dry": "node scripts/resolve-scope3.mjs --dry-run",
    "esg:test-scope3": "node scripts/validate-scope3-seed.mjs && node scripts/test-scope3.mjs",
    "esg:verify-resolver": "node scripts/verify-resolver.mjs",
    "esg:test-charts": "node scripts/test-chart-data.mjs",
    "esg:test-export": "node scripts/test-export.mjs",
    "esg:validate": "node scripts/validate-esg-seed.mjs",
    "esg:verify": "node scripts/verify-esg-model.mjs",
    "esg:test-entry": "tsx scripts/test-parse-quantity.ts && tsx scripts/test-site-validation.ts && tsx scripts/test-entry-resolution.ts",
    "esg:test-import": "tsx scripts/test-import.ts",
    "esg:test-commit": "node scripts/test-commit-values.mjs",
    "esg:test-engine": "node scripts/test-resolver.mjs",
    "esg:check": "npm run esg:validate && npm run esg:verify && npm run esg:test-engine && npm run esg:test-entry && npm run esg:test-import && npm run esg:test-template && npm run esg:test-constants && npm run esg:test-scope3",
    "esg:test-template": "tsx scripts/test-standard-template.ts",
    "esg:test-constants": "tsx scripts/test-constants.ts",
    "esg:test-standard-output": "node scripts/test-standard-output.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.90.5",
    "@vercel/blob": "^0.27.3",
    "@vercel/sandbox": "^1.10.1",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "mermaid": "^11.14.0",
    "next": "^14.2.35",
    "openai": "^6.42.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-grid-layout": "^1.3.5",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5"
  }
}
